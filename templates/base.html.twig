<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Movie Library{% endblock %}</title><link rel="stylesheet" href="/app.css">
<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true,"historyCacheSize":0,"includeIndicatorStyles":false,"timeout":5000}'>
<script src="/vendor/htmx/htmx-2.0.8.min.js" defer></script><script src="/app.js" defer></script></head>
<body>
<header><a class="brand" href="{{ path('library') }}"><span class="mark">ML</span> Movie Library</a><span class="badge">LOCAL CATALOG</span>
{% if app.user %}<form method="post" action="{{ path('logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="subtle">Sign out</button></form>{% endif %}</header>
{% if app.user %}<nav aria-label="Main navigation"><a href="{{ path('library') }}">Library</a><a href="{{ path('locations') }}">Locations</a><a href="{{ path('runs') }}">Scan history</a><a href="{{ path('match_review') }}">Review matches</a><a href="{{ path('settings') }}">Settings</a></nav>{% endif %}
<main>{% if app.user %}{{ render(path('job_status')) }}{% endif %}{% for type, messages in app.flashes %}{% for message in messages %}<p class="notice {{ type }}" role="status">{{ message }}</p>{% endfor %}{% endfor %}
{% block body %}{% endblock %}</main><footer>Your collection, on your computer. Media files are never modified.</footer>
</body></html>
