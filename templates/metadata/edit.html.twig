{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">{{ type == 'movies' ? 'MOVIE' : 'TV SERIES' }} MATCH</p><h1>{{ title.title }}</h1><p>{{ title.matching_state|replace({'_':' '}) }} · {{ title.manual_lock ? 'Manual match locked' : 'Automatic matching enabled' }}</p><a href="{{ path('title_detail',{type:type,id:title.id}) }}">View title</a>
{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
<section class="panel"><h2>Source evidence</h2>{% for file in files %}<p><a href="{{ path('file_assign',{id:file.id}) }}">Correct movie/TV or episode assignment</a> · {{ file.filename }}</p><code>{{ file.original_path }}</code><pre>{{ file.parsed_fields }}</pre>{% else %}<p>No linked files.</p>{% endfor %}</section>
<section class="panel"><h2>Search TMDB</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('match-' ~ type ~ '-' ~ title.id) }}"><label for="query">Search title</label><input id="query" name="query" value="{{ title.title }}" required maxlength="200"><button name="action" value="search">Search candidates</button></form><p>Search runs in the metadata queue. Refresh after completion to review results.</p></section>
{% for candidate in candidates %}<article class="panel"><div class="metadata-row">{% if candidate.poster %}<img class="poster" src="{{ path('poster',{key:candidate.poster}) }}" alt="Poster for {{ candidate.data.title }}" loading="lazy">{% endif %}<div><h2>{{ candidate.data.title }} {{ candidate.data.year }}</h2><p>Score {{ candidate.score }} · {{ candidate.content_type }}</p><details><summary>Matching evidence</summary><pre>{{ candidate.evidence }}</pre></details>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('match-' ~ type ~ '-' ~ title.id) }}"><input type="hidden" name="provider_id" value="{{ candidate.provider_id }}">{% if title.tmdb_id and title.tmdb_id != candidate.provider_id %}<label><input type="checkbox" name="reassignment" value="1" required> I confirm a different title identity. Watched state stays with the previous title.</label>{% endif %}<button name="action" value="confirm">Confirm this match</button></form></div></div></article>{% endfor %}
<section class="panel"><h2>Local correction</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('match-' ~ type ~ '-' ~ title.id) }}"><label for="local-title">Display title</label><input id="local-title" name="title" value="{{ title.title }}" required maxlength="200"><label for="year">Year (optional)</label><input id="year" name="year" value="{{ title.release_year }}" inputmode="numeric"><label for="imdb">Confirmed IMDb title URL (optional)</label><input id="imdb" name="imdb" value="{{ title.imdb_id ? 'https://www.imdb.com/title/' ~ title.imdb_id ~ '/' : '' }}" type="url"><button name="action" value="edit">Save local correction</button> <button name="action" value="unmatched">Leave unmatched and lock</button></form></section>
<section class="panel"><h2>Retry or rematch</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('match-' ~ type ~ '-' ~ title.id) }}"><button name="action" value="retry">Retry lookup / refresh metadata</button> <button name="action" value="rematch" class="subtle">Explicitly reopen matching</button></form><p>Refresh keeps a manual title lock. Reopen matching allows automatic review again. Changed file sizes and rescans preserve manual corrections.</p>
{% for run in runs %}<p><a href="{{ path('run_detail',{id:run.id}) }}">{{ run.state|replace({'_':' '}) }}</a> · {{ run.summary }}</p>{% endfor %}</section>{% endblock %}
