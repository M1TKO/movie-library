{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">ONLINE METADATA</p><h1>TMDB settings</h1>
{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}{% if notice %}<p class="notice success" role="status">{{ notice }}</p>{% endif %}
<section class="panel"><p>TMDB credential: {{ configured ? 'Configured (hidden)' : 'Not configured — offline catalog available' }}</p>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('metadata-settings') }}">
<label for="credential">API Read Access Token</label><input type="password" id="credential" name="credential" autocomplete="new-password" maxlength="2048"><small>Leave blank to keep the saved token. Get a token from your <a href="https://www.themoviedb.org/settings/api" rel="noreferrer">TMDB account API settings</a>. The token stays on this host and is never returned to your browser.</small>
<label for="language">Metadata language</label><input id="language" name="language" value="{{ language }}" required maxlength="5"><small>For example en-US, bg-BG, fr-FR. Refresh a title to apply a new language. Original titles are retained.</small>
<button name="action" value="save">Save metadata settings</button> <button name="action" value="validate">Save and validate TMDB</button> <button name="action" value="remove" class="subtle">Remove credential</button></form></section>
<section class="panel"><h2>Enrichment</h2><p>Discovery queues new filename candidates separately. Existing local entries can be queued below. Provider failures never stop discovery or availability checks. No media contents or full paths are sent to TMDB.</p>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('metadata-settings') }}"><button name="action" value="queue">Queue pending titles</button></form><p><a href="{{ path('match_review') }}">Review matches and retry lookups</a></p></section>
<section class="panel"><h2>Credits</h2><a href="https://www.themoviedb.org" rel="noreferrer"><img class="tmdb-logo" src="/tmdb-logo.svg" alt="TMDB"></a><p>This product uses the TMDB API but is not endorsed or certified by TMDB.</p><p>Metadata and images provided by TMDB. <a href="https://developer.themoviedb.org/docs/faq">Usage and attribution</a>.</p></section>{% endblock %}
