{% extends 'base.html.twig' %}
{% block body %}<h1>Correct file assignment</h1><p>{{ file.filename }}</p><code>{{ file.original_path }}</code><pre>{{ file.parsed_fields }}</pre>
{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
<section class="panel"><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('file-assign-' ~ file.id) }}"><label for="type">Content type</label><select id="type" name="type"><option value="movie">Movie</option><option value="tv"{{ parsed.type|default('') == 'tv' ? ' selected' : '' }}>TV series</option></select>
<label for="title">Movie or series title</label><input id="title" name="title" value="{{ parsed.title|default('') }}" required maxlength="200"><label for="year">Year (optional)</label><input id="year" name="year" value="{{ parsed.year|default('') }}" inputmode="numeric">
<label for="season">TV season (0 for specials)</label><input id="season" name="season" value="{{ parsed.season|default('') }}" inputmode="numeric"><label for="episodes">TV episode numbers</label><input id="episodes" name="episodes" value="{{ parsed.episodes|default([])|join(' ') }}"><small>Space or comma separated; for example 1 2 for a multi-episode file. Confirm date-based or absolute numbering here. Only assigned, owned episodes are cataloged.</small><p>This replaces the file's catalog links. Previous title history and watched state remain with their identities. No media file is changed.</p><button>Save file assignment</button></form></section>{% endblock %}
