{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">{{ run.job_type|upper }}</p><h1>{{ run.job_type == 'enrichment' ? 'Metadata progress' : (run.job_type == 'discovery' ? 'Scan progress' : 'Availability progress') }}</h1>
<section class="panel" id="run-progress" {% if run.state in ['queued','running'] %}hx-get="{{ path('run_detail', {id:run.id,page:page}) }}" hx-trigger="every 2s" hx-select="#run-progress" hx-swap="outerHTML"{% endif %}>
<p role="status"><strong>{{ run.state|replace({'_':' '})|capitalize }}</strong>{% if run.cancel_requested %} · Cancellation requested{% endif %}</p>
{% if run.state in ['queued','running'] and not workerHealthy %}<p class="notice warning">{{ run.job_type == 'enrichment' ? 'Metadata' : 'Filesystem' }} worker is stopped or not responding. Start the normal application launcher, or run the filesystem worker shown in Settings. Your queued scan is saved.</p>{% endif %}
{% if run.job_type == 'enrichment' %}<p>{{ run.enrichment_pending }} pending � {{ run.enrichment_matched }} matched � {{ run.enrichment_review }} review � {{ run.enrichment_failed }} failed</p><p><a href="{{ path('match_review') }}">Review metadata results / retry</a></p>{% else %}<p>{{ run.examined }} distinct files examined · {{ run.added }} added · {{ run.changed }} changed · {{ run.restored }} restored · {{ run.unchanged }} unchanged · {{ run.newly_missing }} newly missing · {{ run.uncheckable }} uncheckable</p>{% endif %}<p>{{ run.summary }}</p>
<p class="muted">Queued: {{ run.queued_at }} · Last heartbeat: {{ run.heartbeat_at|default('Waiting', true) }}</p>
{% for root in roots %}<article><code>{{ root.root_snapshot }}</code><p>{{ root.accessibility|replace({'_':' '}) }} · {{ root.enumeration_outcome|replace({'_':' '}) }}</p>{% if root.error_reason %}<p class="notice error">{{ root.error_reason }}</p>{% endif %}</article>{% endfor %}
{% if run.state in ['queued','running'] %}<form method="post" action="{{ path('run_cancel', {id:run.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cancel-' ~ run.id) }}"><button id="cancel-scan" class="subtle">{{ run.job_type == 'enrichment' ? 'Cancel metadata' : 'Cancel scan' }}</button></form>{% endif %}
<p><a href="{{ path('run_detail', {id:run.id,page:page}) }}">Refresh progress</a> · <a href="{{ path('library') }}">Browse saved discoveries</a></p>
{% if run.job_type != 'enrichment' %}<h2>File outcomes</h2>{% for file in files %}<article class="file-row"><a href="{{ file.file_id ? path('file_detail', {id:file.file_id}) : '#' }}">{{ file.path_snapshot }}</a><p>{{ file.outcome|replace({'_':' '}) }}{% if file.details %} · {{ file.details }}{% endif %}</p></article>{% else %}<p>No file outcomes recorded yet.</p>{% endfor %}{% endif %}
</section>
<div class="row">{% if page > 1 %}<a href="{{ path('run_detail', {id:run.id,page:page-1}) }}">Previous</a>{% endif %}{% if files|length == 50 %}<a href="{{ path('run_detail', {id:run.id,page:page+1}) }}">Next</a>{% endif %}</div>
{% if run.state not in ['queued','running'] %}<p>Start a new scan from <a href="{{ path('locations') }}">Locations</a> to retry one root, or scan all enabled roots from <a href="{{ path('runs') }}">Scan history</a>.</p>{% endif %}
{% endblock %}
