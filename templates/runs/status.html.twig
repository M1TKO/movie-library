<aside id="job-status" aria-label="Background jobs" hx-get="{{ path('job_status') }}" hx-trigger="every 2s" hx-swap="outerHTML"><p aria-live="polite">{% for job in jobs %}<a href="{{ path('run_detail',{id:job.id}) }}">{{ job.job_type|capitalize }}: {{ job.state }} · {{ job.examined }} files{% if job.cancel_requested %} · cancelling{% endif %}</a>{% if not loop.last %} | {% endif %}{% else %}No active background jobs{% endfor %}</p></aside>