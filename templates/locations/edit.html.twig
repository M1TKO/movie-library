{% extends 'base.html.twig' %}
{% block body %}<h1>Edit location</h1><code>{{ location.root_path }}</code>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
<form method="post" class="panel"><input type="hidden" name="_token" value="{{ csrf_token('edit-' ~ location.id) }}"><label for="label">Label</label><input id="label" name="label" maxlength="100" required value="{{ location.label }}"><label class="checkbox"><input type="checkbox" name="recursive" value="1" {{ location.recursive ? 'checked' : '' }}> Include subfolders</label><label for="exclusions">Exclusions (one glob rule per line)</label><textarea id="exclusions" name="exclusions" rows="7">{{ exclusions }}</textarea><small>Match file/folder names or root-relative paths. * matches any characters; ? matches one. Empty means no exclusions.</small><button>Save changes</button></form>
<p><a href="{{ path('location_relocate', {id:location.id}) }}">Relocate this collection to a new root</a></p><section class="panel"><h2>Remove location configuration</h2><p>Files and their history stay in the catalog. Copies without another enabled location become Not monitored. Media files are never deleted.</p><form method="post" action="{{ path('location_remove',{id:location.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('remove-' ~ location.id) }}"><button class="subtle">Remove location; keep catalog</button></form></section>{% endblock %}
