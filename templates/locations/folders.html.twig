{% extends 'base.html.twig' %}
{% block body %}<h1>Browse host folders</h1><p>Enter a folder on the computer running Movie Library. Only that folder's immediate children are listed; no drives are searched automatically.</p>
<form method="get"><label for="path">Absolute host folder</label><input id="path" name="path" value="{{ folder }}" placeholder="D:\Movies or /mnt/media" required><button>Browse folder</button></form>
{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
{% if result %}<section class="panel"><code>{{ folder }}</code><p><a class="button" href="{{ path('locations',{path:folder}) }}">Use this folder</a></p>{% if not result.accessible %}<p class="notice warning">Access could not be verified within 3 seconds. The folder may be offline, linked, or inaccessible. You can still save it.</p>{% else %}{% for child in result.children %}<p><a href="{{ path('folders',{path:child.path}) }}">{{ child.name }}</a></p>{% else %}<p>No subfolders.</p>{% endfor %}{% if result.truncated %}<p class="notice warning">Folder listing was capped at 200 folders or 5,000 entries. Enter a more specific path.</p>{% endif %}{% endif %}</section>{% endif %}{% endblock %}
