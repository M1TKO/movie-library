{% extends 'base.html.twig' %}
{% block title %}Locations · Movie Library{% endblock %}
{% block body %}<p class="eyebrow">ON YOUR COMPUTER</p><h1>Media locations</h1><p class="muted">These are folders on the computer running Movie Library, including attached drives and mounted network shares.</p>
<p><a href="{{ path('folders') }}">Browse folders on this computer</a></p><div class="columns"><section class="panel"><h2>Add a location</h2>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('locations') }}">
<label for="label">Label</label><input id="label" name="label" maxlength="100" value="{{ input.label }}" placeholder="Living room drive" required>
<label for="path">Absolute folder path</label><input id="path" name="path" value="{{ input.path }}" placeholder="D:\Movies or /mnt/media/movies" required><small>Use a path on the server. Saving performs a bounded folder-access check; it never starts discovery or uploads files.</small>
<label for="hint">Content</label><select id="hint" name="hint">{% for value, label in {'mixed':'Movies and TV', 'movies':'Movies', 'tv':'TV series'} %}<option value="{{ value }}" {{ input.hint == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>
<label class="checkbox"><input type="checkbox" name="recursive" value="1" {{ input.recursive ? 'checked' : '' }}> Include subfolders</label><label for="exclusions">Exclusions (one glob rule per line)</label><textarea id="exclusions" name="exclusions" rows="5">{{ input.exclusions }}</textarea><small>File/folder names or root-relative paths; * and ? are supported. Remove rules to include samples or trailers. No minimum file size.</small><button>Save location</button></form></section>
<section><h2>Saved folders <span class="badge">{{ locations|length }}</span></h2>{% for location in locations %}<article class="panel location"><div class="row"><h3>{{ location.label }}</h3><span class="badge">{{ location.enabled ? 'Enabled' : 'Disabled' }}</span></div><code>{{ location.root_path }}</code><p class="muted">{{ location.content_hint == 'mixed' ? 'Movies and TV' : (location.content_hint == 'tv' ? 'TV series' : 'Movies') }} · {{ location.recursive ? 'Includes subfolders' : 'This folder only' }}</p><p class="muted">{{ location.status|replace({'_':' '}) }}{% if location.last_error %} · {{ location.last_error }}{% endif %}</p><a href="{{ path('location_edit',{id:location.id}) }}">Edit settings or remove</a>{% if location.enabled %}<form method="post" action="{{ path('scan_start') }}"><input type="hidden" name="_token" value="{{ csrf_token('scan') }}"><input type="hidden" name="location" value="{{ location.id }}"><button>Scan this location</button></form>{% endif %}
<form method="post" action="{{ path('location_toggle', {id: location.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('toggle-' ~ location.id) }}"><button class="subtle">{{ location.enabled ? 'Disable' : 'Enable' }}</button></form></article>{% else %}<div class="panel empty"><h3>No locations yet</h3><p>Add a folder to begin configuring your library.</p></div>{% endfor %}</section></div>{% endblock %}
