{% extends 'base.html.twig' %}
{% block title %}Create your owner account · Movie Library{% endblock %}
{% block body %}<section class="auth panel"><p class="eyebrow">WELCOME HOME</p><h1>A home for your collection.</h1><p class="muted">Create the single owner account on this computer. You’ll use this password to open your library.</p>
{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('setup') }}">
<label for="password">Password</label><input id="password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required><small>Use at least 12 characters.</small>
<label for="confirm">Confirm password</label><input id="confirm" name="confirm" type="password" autocomplete="new-password" required>
<button>Create owner account</button></form><p class="muted">Internet access and metadata credentials are not needed for setup.</p></section>{% endblock %}
