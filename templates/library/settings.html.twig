{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">PREFERENCES</p><h1>Settings</h1>
<section class="panel"><h2>Discovery and inspection</h2>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}{% if probeVersion %}<p class="notice success">{{ probeVersion }}</p>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('settings') }}"><label for="extensions">Video extensions</label><input id="extensions" name="extensions" value="{{ extensions }}" required><small>Space-separated, without dots. Changing these applies to future scans.</small><label for="ffprobe">FFprobe executable</label><input id="ffprobe" name="ffprobe" value="{{ ffprobe }}" required><small>Executable on this host (for example C:\ffmpeg\bin\ffprobe.exe or /usr/bin/ffprobe). Bounded inspection concurrency, with a 10 second timeout. Corrupt files remain cataloged.</small><label for="page_size">Default page size</label><select id="page_size" name="page_size">{% for size in [25,50,100] %}<option {{ preferences.page_size == size ? 'selected' : '' }}>{{ size }}</option>{% endfor %}</select>
<label for="probe_concurrency">Concurrent inspections</label><select id="probe_concurrency" name="probe_concurrency">{% for size in [1,2] %}<option {{ preferences.probe_concurrency == size ? 'selected' : '' }}>{{ size }}</option>{% endfor %}</select>
<label for="poster_cache_mib">Poster cache limit (MiB)</label><input id="poster_cache_mib" name="poster_cache_mib" type="number" min="10" max="1024" value="{{ preferences.poster_cache_mib }}">
<label for="retention_days">Backup and rotated-log retention (days)</label><input id="retention_days" name="retention_days" type="number" min="1" max="365" value="{{ preferences.retention_days }}"><small>Run the local maintenance command to remove expired backups and rotated logs. The latest backup and catalog history are retained.</small>
<label for="log_level">Diagnostic logging</label><select id="log_level" name="log_level"><option value="errors" {{ preferences.log_level == 'errors' ? 'selected' : '' }}>Errors</option><option value="verbose" {{ preferences.log_level == 'verbose' ? 'selected' : '' }}>Verbose</option></select>
<label for="lan_address">Host private IPv4 address</label><input id="lan_address" name="lan_address" value="{{ preferences.lan_address }}" placeholder="192.168.1.10"><label class="checkbox"><input type="checkbox" name="lan_enabled" value="1" {{ preferences.lan_enabled == 'true' ? 'checked' : '' }}> Enable home-network access</label><small>Change this locally after owner setup. Restart the normal launcher to apply the binding. Allow this port only from your private subnet in the host firewall. Public addresses are rejected.</small>
<label class="checkbox"><input type="checkbox" name="host_actions" value="1" {{ hostEnabled and hostDesktop ? 'checked' : '' }} {{ not hostDesktop ? 'disabled' : '' }}> Enable playback and folder opening on the host</label><p>Requires an interactive desktop configured by the launcher. Actions run on the host; playback leaves watched state unchanged.</p><button name="action" value="save">Save settings</button> <button name="action" value="validate" class="subtle">Save and validate FFprobe</button></form></section>
<section class="panel"><h2>Local catalog</h2><p><a href="{{ path('backups') }}">Back up or restore the catalog</a>. Per-location exclusions are configured in Locations.</p><dl><dt>Network access</dt><dd>{{ preferences.lan_enabled == 'true' ? 'Private LAN enabled; restart after changes.' : 'Localhost only.' }}</dd><dt>Host playback and folder actions</dt><dd>{{ hostDesktop ? (hostEnabled ? 'Enabled on the host desktop.' : 'Disabled; enable above.') : 'Disabled: no interactive desktop configured.' }}</dd><dt>Metadata provider</dt><dd><a href="{{ path('metadata_settings') }}">Configure TMDB credentials and language</a>. Discovery and filename candidates work offline.</dd><dt>Background jobs</dt><dd>Use Locations or Scan history to start a manual scan. Saving a location never starts discovery. Known-path availability checks run at startup and in a fresh library session.</dd></dl></section><section class="panel"><h2>Background workers</h2>{% for worker in workers %}<h3>{{ worker.name|capitalize }}</h3><p>{{ worker.status }} · Last heartbeat (UTC): {{ worker.heartbeat }}</p>{% if worker.error %}<p class="notice error">{{ worker.error }}</p>{% endif %}{% endfor %}<p class="muted">If a worker stops, restart using the production start script. Development launchers only start HTTP. For development, use the same APP_DATA_DIR and run <code>php bin/console messenger:consume filesystem --sleep=1</code> in another terminal. Worker logs are in the application data directory under logs/.</p></section>{% endblock %}
