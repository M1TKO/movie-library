{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">PREFERENCES</p><h1>Settings</h1>
<section class="panel"><h2>Discovery and inspection</h2>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}{% if probeVersion %}<p class="notice success">{{ probeVersion }}</p>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('settings') }}"><label for="extensions">Video extensions</label><input id="extensions" name="extensions" value="{{ extensions }}" required><small>Space-separated, without dots. Changing these applies to future scans.</small><label for="ffprobe">FFprobe executable</label><input id="ffprobe" name="ffprobe" value="{{ ffprobe }}" required><small>Executable on this host (for example C:\ffmpeg\bin\ffprobe.exe or /usr/bin/ffprobe). One inspection at a time, with a 10 second timeout. Corrupt files remain cataloged.</small><label class="checkbox"><input type="checkbox" name="host_actions" value="1" {{ hostEnabled and hostDesktop ? 'checked' : '' }} {{ not hostDesktop ? 'disabled' : '' }}> Enable playback and folder opening on the host</label><p>Requires an interactive desktop configured by the launcher. Actions run on the host; playback leaves watched state unchanged.</p><button name="action" value="save">Save settings</button> <button name="action" value="validate" class="subtle">Save and validate FFprobe</button></form></section>
<section class="panel"><h2>Local catalog</h2><dl><dt>Network access</dt><dd>Localhost only. LAN deployment is planned for the release phase.</dd><dt>Host playback and folder actions</dt><dd>{{ hostDesktop ? (hostEnabled ? 'Enabled on the host desktop.' : 'Disabled; enable above.') : 'Disabled: no interactive desktop configured.' }}</dd><dt>Metadata provider</dt><dd><a href="{{ path('metadata_settings') }}">Configure TMDB credentials and language</a>. Discovery and filename candidates work offline.</dd><dt>Background jobs</dt><dd>Use Locations or Scan history to start a manual scan. Saving a location never starts discovery. Known-path availability checks run at startup and in a fresh library session.</dd></dl></section><section class="panel"><h2>Background workers</h2>{% for worker in workers %}<h3>{{ worker.name|capitalize }}</h3><p>{{ worker.status }} · Last heartbeat (UTC): {{ worker.heartbeat }}</p>{% if worker.error %}<p class="notice error">{{ worker.error }}</p>{% endif %}{% endfor %}<p class="muted">If a worker stops, restart using the production start script. Development launchers only start HTTP. For development, use the same APP_DATA_DIR and run <code>php bin/console messenger:consume filesystem --sleep=1</code> in another terminal. Worker logs are in the application data directory under logs/.</p></section>{% endblock %}
