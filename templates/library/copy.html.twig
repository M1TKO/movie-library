<article class="panel"><h2><a href="{{ path('file_detail',{id:file.id}) }}">{{ file.filename }}</a></h2><p>{{ file.check_outcome|replace({'_':' '}) }} · {{ file.size_bytes is not null ? (file.size_bytes / 1000000000)|number_format(3) ~ ' GB' : 'Unknown size' }} · {{ file.width and file.height ? file.width ~ ' × ' ~ file.height : 'Unknown dimensions' }} · {{ file.duration_seconds is not null ? file.duration_seconds|number_format(2) ~ ' seconds' : 'Unknown duration' }} · Last seen: {{ file.last_seen_at|default('Unknown',true) }}</p>{% include 'library/copy_path.html.twig' with {copyPath:file.original_path} %}{% include 'library/host_actions.html.twig' %}</article>
