{% if hostEnabled and file.check_outcome == 'available' %}<div class="row">{% for action,label in {'folder':'Open folder on host','play':'Play on host'} %}<form method="post" action="{{ path('host_action',{id:file.id,action:action}) }}"><input type="hidden" name="_token" value="{{ csrf_token('host-' ~ file.id) }}"><button>{{ label }}</button></form>{% endfor %}</div>{% else %}<p class="muted">Host actions require an enabled interactive desktop and an available copy.</p>{% endif %}
