{% extends 'base.html.twig' %}
{% block body %}<p><a href="{{ path('title_detail',{type:'series',id:season.series_id}) }}">{{ season.series_title }}</a></p><h1>{{ season.season_number == 0 ? 'Specials' : 'Season ' ~ season.season_number }}</h1><p><a href="{{ path('watched',{type:'seasons',id:season.id}) }}">Preview season watched change</a></p>{% for episode in episodes %}<article class="panel"><h2><a href="{{ path('episode_detail',{id:episode.id}) }}">Episode {{ episode.episode_number }} · {{ episode.title }}</a></h2><p>{{ episode.watched ? 'Watched' : 'Unwatched' }} · {{ episode.copies }} copies · {{ episode.available }} available, {{ episode.missing }} missing, {{ episode.uncheckable }} uncheckable</p></article>{% else %}<p>No cataloged episodes.</p>{% endfor %}{% endblock %}
