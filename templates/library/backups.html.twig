{% extends 'base.html.twig' %}
{% block body %}<h1>Catalog backups</h1><p>Backups retain titles, paths, watched state, locations and history. They exclude owner passwords, TMDB credentials, sessions, queues and poster cache. Media stays untouched. Store these private catalog files securely.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('backup') }}"><button>Create consistent backup</button></form><h2>Saved backups on this host</h2><ul>{% for item in items %}<li><code>{{ item }}</code></li>{% else %}<li>No backups yet.</li>{% endfor %}</ul><h2>Restore locally</h2><p>Stop the application and all workers. In a terminal on this host, use the same APP_DATA_DIR and run <code>php bin/console app:restore "BACKUP_DIRECTORY"</code>. Confirm replacement and enter your current owner password. Validation and a pre-restore backup precede an atomic catalog transaction. Current credentials remain; network and host actions return to disabled. Restart and retry interrupted jobs manually.</p><a href="{{ path('settings') }}">Settings</a>{% endblock %}
