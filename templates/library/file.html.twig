{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">PHYSICAL COPY</p><h1>{{ file.filename }}</h1><section class="panel">{% include 'library/copy_path.html.twig' with {copyPath:file.original_path} %}
{% include 'library/host_actions.html.twig' %}<dl><dt>Latest outcome / last known availability</dt><dd>{{ file.check_outcome|replace({'_':' '}) }} / {{ file.last_known_availability|default('unknown',true) }}</dd><dt>Size</dt><dd>{{ file.size_bytes is not null ? file.size_bytes : 'Unknown' }} bytes · {{ (file.size_bytes / 1000000000)|number_format(3) }} GB</dd><dt>Dimensions</dt><dd>{{ file.width and file.height ? file.width ~ ' × ' ~ file.height : 'Unknown' }}</dd><dt>Duration</dt><dd>{{ file.duration_seconds is not null ? file.duration_seconds|number_format(2) ~ ' seconds' : 'Unknown' }}</dd><dt>Video / audio</dt><dd>{{ file.video_codec|default('Unknown',true) }} / {{ file.audio_codec|default('Unknown',true) }}</dd><dt>Inspection</dt><dd>{{ file.probe_state }} · {{ file.probed_at|default('Not yet inspected',true) }}{% if file.probe_error %}<p class="notice warning">{{ file.probe_error }}</p>{% endif %}</dd><dt>Last seen</dt><dd>{{ file.last_seen_at|default('Unknown',true) }}</dd></dl></section>
<section class="panel"><h2>Content</h2><p><a href="{{ path('file_assign',{id:file.id}) }}">Correct movie/TV and episode assignment</a></p>{% for link in links %}{% if link.movie_id %}<p><a href="{{ path('title_detail',{type:'movies',id:link.movie_id}) }}">{{ link.movie_title }}</a></p>{% else %}<p><a href="{{ path('title_detail',{type:'series',id:link.series_id}) }}">{{ link.series_title }}</a> · <a href="{{ path('season_detail',{id:link.season_id}) }}">Season {{ link.season_number }}</a>, <a href="{{ path('episode_detail',{id:link.episode_id}) }}">episode {{ link.episode_number }}</a></p>{% endif %}{% else %}<p>Unresolved file. It remains in your library independently of title identification.</p>{% endfor %}<h2>Locations</h2>{% for location in locations %}<p>{{ location.label }} · {{ location.enabled and location.in_scope ? 'Monitored' : 'Not monitored' }}</p>{% else %}<p>Not monitored by a configured location.</p>{% endfor %}</section>{% include 'library/history.html.twig' with {historyLabel:'File',historyRoute:'file_detail',historyParams:{id:file.id}} %}{% endblock %}
