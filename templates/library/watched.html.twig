{% extends 'base.html.twig' %}
{% block body %}<h1>Preview watched change</h1><section class="panel"><h2>{{ item.title|default('Season ' ~ item.season_number|default('')) }}</h2>{% if error %}<p role="alert">{{ error }}</p>{% endif %}<p>{{ targets|length }} {{ type == 'movies' ? 'movie' : 'cataloged episodes' }} affected. Only content currently in the catalog is included; future episodes start unwatched.</p><ul>{% for target in targets %}<li>{{ target.title }} · {{ target.watched ? 'Watched' : 'Unwatched' }}</li>{% endfor %}</ul>{% if targets %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('watched-' ~ type ~ '-' ~ item.id) }}"><input type="hidden" name="snapshot" value="{{ snapshot }}"><button name="state" value="1">Confirm mark watched</button> <button name="state" value="0">Confirm mark unwatched</button></form>{% else %}<p>No cataloged episodes to change.</p>{% endif %}</section>{% endblock %}
