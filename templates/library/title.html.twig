{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">{{ type == 'movies' ? 'MOVIE' : 'TV SERIES' }}</p><h1>{{ title.title }}{% if title.release_year %} ({{ title.release_year }}){% endif %}</h1>
<section class="panel metadata-row">{% if poster %}<img class="poster" src="{{ path('poster',{key:poster}) }}" alt="Poster for {{ title.title }}">{% else %}<div class="poster-placeholder">No poster available</div>{% endif %}<div><p>{{ title.matching_state|replace({'_':' '}) }} · {{ title.metadata_source|default('Local',true) }}{{ title.manual_lock ? ' · Manual lock' : '' }}</p>
{% if title.original_title %}<p>Original title: {{ title.original_title }}</p>{% endif %}<p>{{ title.synopsis|default('No synopsis available.',true) }}</p><p>{{ genres|join(' · ') }}</p>
{% if title.imdb_id %}<a href="https://www.imdb.com/title/{{ title.imdb_id }}/" rel="noreferrer" target="_blank">{{ type == 'series' ? 'Series on IMDb' : 'Movie on IMDb' }}</a>{% else %}<p>No confirmed IMDb link.</p>{% endif %}
<p><a href="{{ path('match_edit',{type:type,id:title.id}) }}">Review or correct metadata</a></p></div></section>
{% if type == 'movies' %}<p>{{ title.watched ? 'Watched' : 'Unwatched' }}{% if title.watched_at %} · {{ title.watched_at }}{% endif %}</p>{% endif %}
<p><a href="{{ path('watched',{type:type,id:title.id}) }}">Preview {{ type == 'series' ? 'series' : 'movie' }} watched change</a></p>
{% include 'library/breakdown.html.twig' %}
{% if type == 'series' %}
{% set watchedEpisodes = 0 %}{% set episodeCount = 0 %}{% for season in seasons %}{% set watchedEpisodes = watchedEpisodes + season.watched %}{% set episodeCount = episodeCount + season.episodes|length %}{% endfor %}
<p>{{ watchedEpisodes == 0 ? 'Unwatched' : (watchedEpisodes == episodeCount ? 'Watched' : 'Partially watched') }} · {{ watchedEpisodes }} / {{ episodeCount }} cataloged episodes watched</p>
<nav aria-label="Seasons">{% for season in seasons %}<article class="panel"><h2><a href="{{ path('season_detail',{id:season.id}) }}">{{ season.season_number == 0 ? 'Specials' : 'Season ' ~ season.season_number }}</a></h2><p>{{ season.state }} · {{ season.watched }} / {{ season.episodes|length }} cataloged episodes watched</p>{% include 'library/breakdown.html.twig' with {totals:season.totals} %}</article>{% else %}<p>No cataloged seasons.</p>{% endfor %}</nav>
{% else %}
{% for file in files %}{% include 'library/copy.html.twig' %}{% else %}<p>No linked copies.</p>{% endfor %}
<nav aria-label="Copy pages">{% if page > 1 %}<a href="{{ path('title_detail',{type:type,id:title.id,page:page-1}) }}">Previous</a>{% endif %}{% if page * 50 < totals.files %}<a href="{{ path('title_detail',{type:type,id:title.id,page:page+1}) }}">Next</a>{% endif %}</nav>
{% endif %}{% include 'library/history.html.twig' with {historyLabel:'Title and linked files',historyRoute:'title_detail',historyParams:{type:type,id:title.id,page:page}} %}{% endblock %}
