{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">{{ type == 'movies' ? 'MOVIE' : 'TV SERIES' }}</p><h1>{{ title.title }}{% if title.release_year %} ({{ title.release_year }}){% endif %}</h1>
<section class="panel metadata-row">{% if poster %}<img class="poster" src="{{ path('poster',{key:poster}) }}" alt="Poster for {{ title.title }}">{% else %}<div class="poster-placeholder">No poster available</div>{% endif %}<div><p>{{ title.matching_state|replace({'_':' '}) }} · {{ title.metadata_source|default('Local',true) }}{{ title.manual_lock ? ' · Manual lock' : '' }}</p>
{% if title.original_title %}<p>Original title: {{ title.original_title }}</p>{% endif %}<p>{{ title.synopsis|default('No synopsis available.',true) }}</p><p>{{ genres|join(' · ') }}</p>
{% if title.imdb_id %}<a href="https://www.imdb.com/title/{{ title.imdb_id }}/" rel="noreferrer" target="_blank">{{ type == 'series' ? 'Series on IMDb' : 'Movie on IMDb' }}</a>{% else %}<p>No confirmed IMDb link.</p>{% endif %}
<p><a href="{{ path('match_edit',{type:type,id:title.id}) }}">Review or correct metadata</a></p></div></section>
{% if type == 'movies' %}<p>{{ title.watched ? 'Watched' : 'Unwatched' }}</p>{% endif %}
{% for file in files %}<article class="panel">{% if type == 'series' %}<h2>Season {{ file.season_number }} · {{ file.episode_title }}</h2>{% if file.episode_imdb %}<p><a href="https://www.imdb.com/title/{{ file.episode_imdb }}/" rel="noreferrer" target="_blank">Episode on IMDb</a></p>{% elseif title.imdb_id %}<p><a href="https://www.imdb.com/title/{{ title.imdb_id }}/" rel="noreferrer" target="_blank">Series on IMDb (episode link unavailable)</a></p>{% endif %}{% endif %}<a href="{{ path('file_detail',{id:file.id}) }}">{{ file.filename }}</a><p>{{ file.check_outcome|replace({'_':' '}) }} · {{ (file.size_bytes / 1000000000)|number_format(3) }} GB · {{ file.width and file.height ? file.width ~ ' × ' ~ file.height : 'Unknown dimensions' }}</p>{% include 'library/copy_path.html.twig' with {copyPath:file.original_path} %}</article>{% else %}<p>No linked copies.</p>{% endfor %}
<div class="row">{% if page > 1 %}<a href="{{ path('title_detail',{type:type,id:title.id,page:page-1}) }}">Previous</a>{% endif %}{% if files|length == 50 %}<a href="{{ path('title_detail',{type:type,id:title.id,page:page+1}) }}">Next</a>{% endif %}</div>{% include 'library/history.html.twig' with {historyLabel:'Title and linked files',historyRoute:'title_detail',historyParams:{type:type,id:title.id,page:page}} %}{% endblock %}
