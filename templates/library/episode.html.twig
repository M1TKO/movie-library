{% extends 'base.html.twig' %}
{% block body %}<p><a href="{{ path('title_detail',{type:'series',id:episode.series_id}) }}">{{ episode.series_title }}</a> · <a href="{{ path('season_detail',{id:episode.season_id}) }}">Season {{ episode.season_number }}</a></p><h1>Episode {{ episode.episode_number }} · {{ episode.title }}</h1><p>{{ episode.watched ? 'Watched' : 'Unwatched' }}{% if episode.watched_at %} · {{ episode.watched_at }}{% endif %} · <a href="{{ path('watched',{type:'episodes',id:episode.id}) }}">Change watched state</a></p>{% if episode.imdb_id %}<p><a href="https://www.imdb.com/title/{{ episode.imdb_id }}/" target="_blank" rel="noreferrer">Episode on IMDb</a></p>{% elseif episode.series_imdb %}<p><a href="https://www.imdb.com/title/{{ episode.series_imdb }}/" target="_blank" rel="noreferrer">Series on IMDb (episode link unavailable)</a></p>{% endif %}{% include 'library/breakdown.html.twig' %}{% for file in files %}{% include 'library/copy.html.twig' %}{% else %}<p>No linked copies.</p>{% endfor %}<nav aria-label="Copy pages">{% if page > 1 %}<a href="{{ path('episode_detail',{id:episode.id,page:page-1}) }}">Previous</a>{% endif %}{% if page * 50 < count %}<a href="{{ path('episode_detail',{id:episode.id,page:page+1}) }}">Next</a>{% endif %}</nav>{% include 'library/history.html.twig' with {historyLabel:'Episode and linked copies',historyRoute:'episode_detail',historyParams:{id:episode.id,page:page}} %}{% endblock %}
