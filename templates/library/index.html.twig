{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">THE COLLECTION</p><h1>Your library</h1><p class="muted">Saved movies, series, and every copy you keep. Local filename candidates remain pending online identification.</p>
{% if availabilityRun %}<p role="status"><a href="{{ path('run_detail',{id:availabilityRun.id}) }}">{{ availabilityRun.state in ['queued','running'] ? 'Checking availability' : 'Latest availability check: ' ~ availabilityRun.state|replace({'_':' '}) }}</a> · {{ availabilityRun.finished_at|default(availabilityRun.queued_at,true) }}</p>{% endif %}
<form method="post" action="{{ path('availability_start') }}"><input type="hidden" name="_token" value="{{ csrf_token('availability') }}"><button class="subtle">Check known file availability</button></form>
<div class="stats"><article class="panel"><span>Movies / series / episodes</span><strong>{{ stats.movies }} / {{ stats.series }} / {{ stats.episodes }}</strong></article><article class="panel"><span>Physical files</span><strong>{{ stats.media_files }}</strong></article><article class="panel"><span>Unresolved files</span><strong>{{ stats.unresolved }}</strong></article></div>
<p>Whole-library watched movies / cataloged episodes: {{ stats.watched.watched }} watched, {{ stats.watched.unwatched }} unwatched · {{ stats.availability.available }} available, {{ stats.availability.missing }} missing, {{ stats.availability.uncheckable }} uncheckable files</p><p>Whole-library series: {{ stats.series_states.watched }} watched, {{ stats.series_states.partial }} partially watched, {{ stats.series_states.unwatched }} unwatched</p><p>Whole-library available storage: {{ (stats.available_bytes / 1000000000)|number_format(3) }} GB</p><div class="row"><nav aria-label="Catalog views">{% for key,label in {'files':'All files','movies':'Movies','series':'TV series','unresolved':'Unresolved'} %}<a href="{{ path('library',filters|merge({view:key,page:1})) }}" {{ view == key ? 'aria-current="page"' : '' }}>{{ label }}</a>{% endfor %}</nav><a href="{{ path('locations') }}">Manage locations</a></div>
<form method="post" action="{{ path('scan_start') }}"><input type="hidden" name="_token" value="{{ csrf_token('scan') }}"><button>Scan all enabled locations</button></form>
<form method="get" class="panel library-filters">
<label>Content<select name="view">{% for value,label in {'files':'All files','movies':'Movies','series':'TV series','unresolved':'Unresolved'} %}<option value="{{ value }}" {{ view == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Search<input name="q" value="{{ q }}" maxlength="200" placeholder="Title, original title or filename"></label>
<label>Availability<select name="availability">{% for value,label in {'':'Any availability','available':'Available','missing':'Missing','uncheckable':'Uncheckable'} %}<option value="{{ value }}" {{ availability == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Watched<select name="watched">{% for value,label in {'':'Any watched state','watched':'Watched','unwatched':'Unwatched','partial':'Partially watched series'} %}<option value="{{ value }}" {{ watched == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Matching<select name="matching">{% for value in ['','pending','auto_matched','manually_confirmed','needs_review','unmatched'] %}<option value="{{ value }}" {{ matching == value ? 'selected' : '' }}>{{ value ? value|replace({'_':' '})|capitalize : 'Any matching state' }}</option>{% endfor %}</select></label>
<label>Location<select name="location"><option value="0">All locations</option>{% for item in locations %}<option value="{{ item.id }}" {{ location == item.id ? 'selected' : '' }}>{{ item.label }}</option>{% endfor %}</select></label>
<label>Resolution<select name="resolution">{% for value,label in {'':'Any resolution','unknown':'Unknown','720':'Below 1080 lines','1080':'1080-2159 lines','2160':'2160+ lines'} %}<option value="{{ value }}" {{ resolution == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Sort<select name="sort">{% for value,label in {'title':'Title / filename','year':'Year','added':'Date added','size':'Size (largest copy for titles)','checked':'Last checked'} %}<option value="{{ value }}" {{ sort == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Direction<select name="direction"><option value="asc" {{ direction == 'asc' ? 'selected' : '' }}>Ascending</option><option value="desc" {{ direction == 'desc' ? 'selected' : '' }}>Descending</option></select></label>
<label>Layout<select name="layout"><option value="table" {{ layout == 'table' ? 'selected' : '' }}>Table</option><option value="posters" {{ layout == 'posters' ? 'selected' : '' }}>Poster grid</option></select></label>
<label>Page size<select name="per_page">{% for count in [25,50,100] %}<option value="{{ count }}" {{ perPage == count ? 'selected' : '' }}>{{ count }}</option>{% endfor %}</select></label><button>Apply filters</button><a href="{{ path('library') }}">Reset filters</a></form>
{% if view in ['movies','series'] %}<p class="muted">Copy filters match titles with at least one qualifying copy. Storage totals include all copies of the selected titles.</p>{% endif %}{% if seriesStates %}<p>Filtered series: {{ seriesStates.watched }} watched, {{ seriesStates.partial }} partially watched, {{ seriesStates.unwatched }} unwatched</p>{% endif %}<p>Filtered movies / cataloged episodes: {{ watchedTotals.watched }} watched, {{ watchedTotals.unwatched }} unwatched</p><p role="status">Filtered: {{ total }} {{ view in ['movies','series'] ? 'titles' : 'files' }} · {{ totals.files }} physical files ({{ totals.available }} available, {{ totals.missing }} missing, {{ totals.uncheckable }} uncheckable) · {{ (totals.available_bytes / 1000000000)|number_format(3) }} GB available · {{ (totals.bytes / 1000000000)|number_format(3) }} GB last-known total · Page {{ page }}</p>
{% if rows %}
{% if layout == 'table' %}<div class="table-scroll"><table><caption>Filtered library</caption><thead><tr><th scope="col">{{ view in ['movies','series'] ? 'Title' : 'File' }}</th><th scope="col">{{ view in ['movies','series'] ? 'Year' : 'Availability' }}</th><th scope="col">{{ view in ['movies','series'] ? 'Matching' : 'Size / dimensions' }}</th></tr></thead><tbody>{% for row in rows %}<tr>{% if view in ['movies','series'] %}<td><h2><a href="{{ path('title_detail',{type:view,id:row.id}) }}">{{ row.title }}</a></h2></td><td>{{ row.release_year|default('Unknown',true) }}</td><td>{{ row.matching_state|replace({'_':' '}) }} · {{ row.watched_summary }}</td>{% else %}<td><h2><a href="{{ path('file_detail',{id:row.id}) }}">{{ row.filename }}</a></h2><code>{{ row.original_path }}</code></td><td>{{ row.check_outcome|replace({'_':' '}) }}</td><td>{{ row.size_bytes is not null ? (row.size_bytes / 1000000000)|number_format(3) ~ ' GB' : 'Unknown size' }} · {{ row.width and row.height ? row.width ~ ' × ' ~ row.height : 'Unknown dimensions' }}</td>{% endif %}</tr>{% endfor %}</tbody></table></div>
{% else %}<div class="poster-grid">{% for row in rows %}<article class="panel">{% if view in ['movies','series'] %}{% if row.poster_key %}<img class="poster" src="{{ path('poster',{key:row.poster_key}) }}" alt="Poster for {{ row.title }}" loading="lazy">{% else %}<div class="poster-placeholder">No poster available</div>{% endif %}<h2><a href="{{ path('title_detail',{type:view,id:row.id}) }}">{{ row.title }}{% if row.release_year %} ({{ row.release_year }}){% endif %}</a></h2><span class="badge">{{ row.matching_state|replace({'_':' '}) }}</span><p>{{ row.watched_summary }}</p>{% else %}<div class="poster-placeholder">Physical copy</div><h2><a href="{{ path('file_detail',{id:row.id}) }}">{{ row.filename }}</a></h2><code>{{ row.original_path }}</code><p>{{ row.check_outcome|replace({'_':' '}) }} · {{ row.size_bytes is not null ? (row.size_bytes / 1000000000)|number_format(3) ~ ' GB' : 'Unknown size' }}</p>{% endif %}</article>{% endfor %}</div>{% endif %}
{% else %}<section class="panel empty"><h2>No matching entries</h2><p>Adjust or reset the filters. Add selected locations and request a scan to discover files.</p></section>{% endif %}
<nav class="row" aria-label="Library pages">{% if page > 1 %}<a href="{{ path('library',filters|merge({page:page-1})) }}">Previous</a>{% endif %}{% if page * perPage < total %}<a href="{{ path('library',filters|merge({page:page+1})) }}">Next</a>{% endif %}</nav>{% endblock %}
