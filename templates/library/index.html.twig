{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">THE COLLECTION</p><h1>Your library</h1><p class="muted">Saved movies, series, and every copy you keep. Local filename candidates remain pending online identification.</p>
{% if availabilityRun %}<p role="status"><a href="{{ path('run_detail',{id:availabilityRun.id}) }}">{{ availabilityRun.state in ['queued','running'] ? 'Checking availability' : 'Latest availability check: ' ~ availabilityRun.state|replace({'_':' '}) }}</a> · {{ availabilityRun.finished_at|default(availabilityRun.queued_at,true) }}</p>{% endif %}
<form method="post" action="{{ path('availability_start') }}"><input type="hidden" name="_token" value="{{ csrf_token('availability') }}"><button class="subtle">Check known file availability</button></form>
<div class="stats"><article class="panel"><span>Movies / series / episodes</span><strong>{{ stats.movies }} / {{ stats.series }} / {{ stats.episodes }}</strong></article><article class="panel"><span>Physical files</span><strong>{{ stats.media_files }}</strong></article><article class="panel"><span>Unresolved files</span><strong>{{ stats.unresolved }}</strong></article></div>
<div class="row"><nav aria-label="Catalog views">{% for key,label in {'files':'All files','movies':'Movies','series':'TV series','unresolved':'Unresolved'} %}<a href="{{ path('library',{view:key}) }}" {{ view == key ? 'aria-current="page"' : '' }}>{{ label }}</a>{% endfor %}</nav><a href="{{ path('locations') }}">Manage locations</a></div>
<form method="post" action="{{ path('scan_start') }}"><input type="hidden" name="_token" value="{{ csrf_token('scan') }}"><button>Scan all enabled locations</button></form>
<p>{{ total }} {{ view in ['movies','series'] ? 'titles' : 'files' }} · Page {{ page }}</p>
{% for row in rows %}<article class="panel">{% if view in ['movies','series'] %}<h2><a href="{{ path('title_detail',{type:view,id:row.id}) }}">{{ row.title }}{% if row.release_year %} ({{ row.release_year }}){% endif %}</a></h2><span class="badge">{{ row.matching_state|replace({'_':' '}) }} · local candidate</span>{% else %}<h2><a href="{{ path('file_detail',{id:row.id}) }}">{{ row.filename }}</a></h2><code>{{ row.original_path }}</code><p>{{ row.check_outcome|replace({'_':' '}) }} · {{ row.size_bytes is not null ? (row.size_bytes / 1000000000)|number_format(3) ~ ' GB' : 'Unknown size' }} · {{ row.width and row.height ? row.width ~ ' × ' ~ row.height : 'Unknown dimensions' }}</p>{% endif %}</article>{% else %}<section class="panel empty"><h2>{{ view == 'unresolved' ? 'No unresolved files' : 'Nothing cataloged here yet' }}</h2><p>Discovery starts only when you request a scan of your selected locations.</p></section>{% endfor %}
<div class="row">{% if page > 1 %}<a href="{{ path('library',{view:view,page:page-1}) }}">Previous</a>{% endif %}{% if page * 50 < total %}<a href="{{ path('library',{view:view,page:page+1}) }}">Next</a>{% endif %}</div>{% endblock %}
