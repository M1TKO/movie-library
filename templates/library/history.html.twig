<section class="panel"><h2>{{ historyLabel }} history</h2><p>{{ eventTotal }} events · Page {{ eventPage }}</p>
{% for event in events %}<details><summary>{{ event.occurred_at }} · {{ event.event_type|replace({'_':' '}) }}{% if event.title_snapshot %} · {{ event.title_snapshot }}{% endif %}{% if event.path_snapshot %} · {{ event.path_snapshot }}{% endif %}</summary><p>{{ event.reason }}</p><pre>Before: {{ event.before_values|default('None',true) }}
After: {{ event.after_values|default('None',true) }}</pre>{% if event.run_id %}<a href="{{ path('run_detail',{id:event.run_id}) }}">Job details</a>{% endif %}</details>{% else %}<p>No changes recorded.</p>{% endfor %}
<nav aria-label="History pages">{% if eventPage > 1 %}<a href="{{ path(historyRoute,historyParams|merge({history_page:eventPage-1})) }}">Previous history</a>{% endif %}{% if eventPage * 50 < eventTotal %}<a href="{{ path(historyRoute,historyParams|merge({history_page:eventPage+1})) }}">Next history</a>{% endif %}</nav></section>
