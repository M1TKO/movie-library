{
  "name": "local/movie-library",
  "description": "Personal Windows and Linux movie and TV catalog",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-pdo_sqlite": "*",
    "doctrine/dbal": "^3.10",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "symfony/console": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/lock": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/", "DoctrineMigrations\\": "migrations/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"sort-packages": true, "allow-plugins": false},
  "scripts": {"test": "phpunit", "check": ["@php bin/console lint:container", "@php bin/console lint:twig templates"]}
}
