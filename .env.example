APP_ENV=dev
APP_DEBUG=0
# Optional absolute path on a LOCAL disk; use forward slashes in dotenv values.
# APP_DATA_DIR=C:/Users/YourName/AppData/Local/MovieLibrary
# Linux default: $XDG_DATA_HOME/movie-library or ~/.local/share/movie-library
# APP_DATA_DIR=/home/yourname/.local/share/movie-library
# APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional desktop launcher attestation; keep unset for services/headless hosts.
# Enable host actions in Settings after configuring and restarting the launcher.
# MOVIE_LIBRARY_INTERACTIVE_DESKTOP=1
